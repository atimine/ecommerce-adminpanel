{{!--
  Shared add / edit dialog for Clients and Couriers (fields: name, phone, telegramId, location).
  Include with:  {{> person-dialog editTitle="Edit client" addTitle="Add courier"}}
  Opened by buttons:
    edit: <button data-edit-person data-action="/clients/5/edit" data-name=".." data-phone=".." data-telegram=".." data-location="..">
    add:  <button data-add-person  data-action="/couriers">
  The dialog posts to data-action.
--}}
<dialog class="dialog dialog--form" id="personDialog" aria-labelledby="personTitle"
        data-edit-title="{{editTitle}}" data-add-title="{{addTitle}}">
  <form class="dialog__box" id="personForm" method="post" novalidate>
    <h2 id="personTitle">{{#if editTitle}}{{editTitle}}{{else}}{{addTitle}}{{/if}}</h2>

    <div class="person-fields">
      <div class="field">
        <label class="field__label" for="pName">Full name</label>
        <input class="input" type="text" id="pName" name="name" maxlength="80" placeholder="Full name" autocomplete="off" required>
        <p class="field__error">Enter the full name.</p>
      </div>
      <div class="field">
        <label class="field__label" for="pPhone">Phone</label>
        <input class="input" type="tel" id="pPhone" name="phone" maxlength="20" placeholder="+998 90 123 45 67" autocomplete="off" required>
        <p class="field__error">Enter a valid phone number.</p>
      </div>
      <div class="field">
        <label class="field__label" for="pTelegram">Telegram ID</label>
        <input class="input" type="text" id="pTelegram" name="telegramId" maxlength="40" placeholder="Telegram ID" autocomplete="off" required>
        <p class="field__error">Enter the Telegram ID.</p>
      </div>
      <div class="field">
        <label class="field__label" for="pLocation">Location</label>
        <input class="input" type="text" id="pLocation" name="location" maxlength="120" placeholder="City, district or address" autocomplete="off">
      </div>
    </div>

    <div class="dialog__actions">
      <button class="btn btn--ghost" type="button" data-dialog-close>Cancel</button>
      <button class="btn btn--primary" type="submit" id="personSubmit">Save changes</button>
    </div>
  </form>
</dialog>
