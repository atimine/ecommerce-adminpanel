{{! Pagination. Needs: pagination: { page, pages, firstUrl, prevUrl, nextUrl, lastUrl }. An empty url disables that button. }}
<nav class='pager' aria-label='Pagination'>
	<p class='pager__info'>Page
		<b>{{pagination.page}}</b>
		of
		<b>{{pagination.pages}}</b></p>
	<div class='pager__btns'>
		{{#if pagination.firstUrl}}<a
				class='pager__btn'
				href='{{pagination.firstUrl}}'
				aria-label='First page'
			><svg class='icon'><use href='#i-chevrons-left' /></svg></a>
		{{else}}<span class='pager__btn is-disabled' aria-disabled='true'><svg
					class='icon'
				><use href='#i-chevrons-left' /></svg></span>{{/if}}

		{{#if pagination.prevUrl}}<a
				class='pager__btn'
				href='{{pagination.prevUrl}}'
				aria-label='Previous page'
			><svg class='icon'><use href='#i-chevron-left' /></svg></a>
		{{else}}<span class='pager__btn is-disabled' aria-disabled='true'><svg
					class='icon'
				><use href='#i-chevron-left' /></svg></span>{{/if}}

		{{#if pagination.nextUrl}}<a
				class='pager__btn'
				href='{{pagination.nextUrl}}'
				aria-label='Next page'
			><svg class='icon'><use href='#i-chevron-right' /></svg></a>
		{{else}}<span class='pager__btn is-disabled' aria-disabled='true'><svg
					class='icon'
				><use href='#i-chevron-right' /></svg></span>{{/if}}

		{{#if pagination.lastUrl}}<a
				class='pager__btn'
				href='{{pagination.lastUrl}}'
				aria-label='Last page'
			><svg class='icon'><use href='#i-chevrons-right' /></svg></a>
		{{else}}<span class='pager__btn is-disabled' aria-disabled='true'><svg
					class='icon'
				><use href='#i-chevrons-right' /></svg></span>{{/if}}
	</div>
</nav>