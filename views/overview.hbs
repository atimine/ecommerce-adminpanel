<div class='overview'>

	<section class='stats-grid' aria-label='Totals'>
		<article class='stat'>
			<header class='stat__top'>
				<h2>Total Revenue</h2>
				<span class='tint tint--orange'><svg class='icon'><use
							href='#i-coin'
						/></svg></span>
			</header>
			<p class='stat__value'>$6659</p>
			<footer class='stat__foot'>
				<span class='trend trend--up'><svg class='icon icon--fill'><use
							href='#i-triangle-up'
						/></svg>2.3%</span>
				<span class='stat__period'>Last Week</span>
				<a class='stat__more' href='/orders'>View more
					<svg class='icon'><use href='#i-arrow-up-right' /></svg></a>
			</footer>
		</article>

		<article class='stat'>
			<header class='stat__top'>
				<h2>Total Products</h2>
				<span class='tint tint--pink'><svg class='icon'><use
							href='#i-package'
						/></svg></span>
			</header>
			<p class='stat__value'>893</p>
			<footer class='stat__foot'>
				<span class='trend trend--up'><svg class='icon icon--fill'><use
							href='#i-triangle-up'
						/></svg>8.1%</span>
				<span class='stat__period'>Last Month</span>
				<a class='stat__more' href='/products'>View more
					<svg class='icon'><use href='#i-arrow-up-right' /></svg></a>
			</footer>
		</article>

		<article class='stat'>
			<header class='stat__top'>
				<h2>Total Orders</h2>
				<span class='tint tint--green'><svg class='icon'><use
							href='#i-bag'
						/></svg></span>
			</header>
			<p class='stat__value'>9856</p>
			<footer class='stat__foot'>
				<span class='trend trend--up'><svg class='icon icon--fill'><use
							href='#i-triangle-up'
						/></svg>2.3%</span>
				<span class='stat__period'>Last Week</span>
				<a class='stat__more' href='/orders'>View more
					<svg class='icon'><use href='#i-arrow-up-right' /></svg></a>
			</footer>
		</article>

		<article class='stat'>
			<header class='stat__top'>
				<h2>Total Customers</h2>
				<span class='tint tint--indigo'><svg class='icon'><use
							href='#i-user-plus'
						/></svg></span>
			</header>
			<p class='stat__value'>4.6k</p>
			<footer class='stat__foot'>
				<span class='trend trend--down'><svg class='icon icon--fill'><use
							href='#i-triangle-down'
						/></svg>10.6%</span>
				<span class='stat__period'>Last Month</span>
				<a class='stat__more' href='/clients'>View more
					<svg class='icon'><use href='#i-arrow-up-right' /></svg></a>
			</footer>
		</article>
	</section>

	<section class='card' aria-labelledby='quickTitle'>
		<div class='section-head'>
			<h2 id='quickTitle'>Quick actions</h2>
			<p>Do the most common tasks in one click.</p>
		</div>

		<div class='actions-grid'>
			<a class='action' href='/couriers/create'>
				<span class='tint tint--blue'><svg class='icon'><use
							href='#i-truck'
						/></svg></span>
				<span class='action__text'><b>Add Courier</b><small>Register a new
						courier</small></span>
				<span class='action__go'><svg class='icon'><use
							href='#i-arrow-up-right'
						/></svg></span>
			</a>

			<a class='action' href='/products/create'>
				<span class='tint tint--orange'><svg class='icon'><use
							href='#i-plus'
						/></svg></span>
				<span class='action__text'><b>Add Product</b><small>Create a new listing</small></span>
				<span class='action__go'><svg class='icon'><use
							href='#i-arrow-up-right'
						/></svg></span>
			</a>

			<a class='action' href='/orders/edit'>
				<span class='tint tint--green'><svg class='icon'><use
							href='#i-check-circle'
						/></svg></span>
				<span class='action__text'><b>Confirm Order</b><small>Review new orders</small></span>
				<span class='action__go'><svg class='icon'><use
							href='#i-arrow-up-right'
						/></svg></span>
			</a>

			<a class='action' href='/clients'>
				<span class='tint tint--red'><svg class='icon'><use
							href='#i-ban'
						/></svg></span>
				<span class='action__text'><b>Block Client</b><small>Restrict a client's
						access</small></span>
				<span class='action__go'><svg class='icon'><use
							href='#i-arrow-up-right'
						/></svg></span>
			</a>
		</div>
	</section>

</div>